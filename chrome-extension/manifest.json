{
  "manifest_version": 3,
  "name": "Wingman AI",
  "version": "2.0.0",
  "description": "Select text on any page and ask Wingman to explain, summarize or draft a reply. Answers appear in the browser side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Wingman AI",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Explain the selected text"
    }
  }
}
