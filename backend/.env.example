# Wingman backend - copy to .env for development.
# The desktop app normally supplies keys itself (stored encrypted in your OS keychain),
# so you only need these when running the backend on its own.

# Pick any one to start. Groq and Gemini have free tiers.
GROQ_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# Local models (no key): install Ollama and `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434

# Initial defaults; changeable in the app
AI_PROVIDER=groq
TRANSCRIPTION_PROVIDER=auto   # auto | groq | openai | local | off

# Where data, logs and the auth token live (default: ~/.wingman)
# WINGMAN_DATA_DIR=
LOG_LEVEL=INFO
